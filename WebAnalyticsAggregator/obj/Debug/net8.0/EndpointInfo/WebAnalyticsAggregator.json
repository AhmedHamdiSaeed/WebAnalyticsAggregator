          "totalSessions": {
            "type": "integer",
            "format": "int32"
          },
          "totalViews": {
            "type": "integer",
            "format": "int32"
          },
          "avgPerformance": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "PageReportDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string",
            "nullable": true
          },
          "totalUsers": {
            "type": "integer",
            "format": "int32"
          },
          "totalSessions": {
            "type": "integer",
            "format": "int32"
          },
          "totalViews": {
            "type": "integer",
            "format": "int32"
          },
          "avgPerformance": {
            "type": "number",
            "format": "double"
          }
